# DigitalOcean GenAI API
DO_API_URL=https://inference.do-ai.run/v1/chat/completions
DO_API_KEY=your_token_here
DO_MODEL=deepseek-4-flash

# Project Configuration
LOG_LEVEL=INFO
PROJECT_NAME=llm-finetuning-grumpy-senior

# Data Generation
GENERATION_DELAY=1.5

# Weights & Biases
WANDB_PROJECT=llm-finetuning
WANDB_ENTITY=your-username
WANDB_API_KEY=

# Model Configuration (Phase 2 — Fine-tuning)
MODEL_NAME=mistralai/Mistral-7B-v0.1
LORA_RANK=8
LEARNING_RATE=5e-4
BATCH_SIZE=4
NUM_EPOCHS=3

# Evaluation (Phase 3)
EVAL_EXAMPLES=15
CLAUDE_API_KEY=
